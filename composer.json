{
    "name": "maxiviper117/laraprep",
    "description": "Safe backend setup scripts and codemods for Laravel projects.",
    "keywords": ["php", "laravel", "cli", "fortify", "codemod"],
    "homepage": "https://github.com/maxiviper117/laraprep",
    "license": "MIT",
    "authors": [{"name": "David", "role": "Developer"}],
    "type": "library",
    "require": {
        "php": "^8.3",
        "nikic/php-parser": "^5.0",
        "symfony/console": "^7.0 || ^8.0",
        "symfony/process": "^7.0 || ^8.0"
    },
    "require-dev": {
        "laravel/pint": "^1.24",
        "pestphp/pest": "^3.8",
        "phpstan/phpstan": "^2.1",
        "rector/rector": "^2.3"
    },
    "autoload": {"psr-4": {"Maxiviper117\\Laraprep\\": "src/"}},
    "autoload-dev": {"psr-4": {"Maxiviper117\\Laraprep\\Tests\\": "tests/"}},
    "bin": ["bin/laraprep"],
    "scripts": {
        "analyse": "phpstan analyse",
        "test": "pest",
        "test-coverage": "pest --coverage --min=100",
        "format": "pint",
        "format-test": "pint --test",
        "refactor": "rector process",
        "refactor-test": "rector process --dry-run",
        "check": ["@format-test", "@analyse", "@refactor-test", "@test"]
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {"pestphp/pest-plugin": true}
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
